# Public repository files. Everything else remains local.
/*
!/.gitignore
!/config
!/Makefile.in
!/README.md
!/USAGE.md
!/NGCC_PROPOSALS_SUMMARY.md
!/src/
!/make/
!/cc_test/
!/ngcc/
!/test-results/

# Generated configuration, binaries and caches.
/src/ngcc_config.h
__pycache__/
*.pyc
.DS_Store

