# Generated by config from Makefile.in. Edit Makefile.in, then reconfigure.
.DEFAULT_GOAL := all
.DELETE_ON_ERROR:

@CONFIGURATION@

ifeq ($(PLATFORM),Darwin)
GMP_ROOT ?= /opt/homebrew/opt/gmp
SHA256 ?= shasum -a 256
else
GMP_ROOT ?= /usr
SHA256 ?= sha256sum
endif
export OPENSSL_PREFIX
OPENSSL_LIBDIR := $(patsubst %/,%,$(dir $(firstword $(wildcard \
    $(OPENSSL_PREFIX)/lib/libcrypto.* $(OPENSSL_PREFIX)/lib64/libcrypto.* \
    $(OPENSSL_PREFIX)/lib/*-linux-gnu/libcrypto.*) $(OPENSSL_PREFIX)/lib/libcrypto.so)))

CFLAGS ?= -O2
CPPFLAGS += -I$(OPENSSL_PREFIX)/include
NM ?= nm
OBJCOPY ?= objcopy
NMEDIT ?= nmedit
RANLIB ?= ranlib
PYTHON ?= python3
JOBS ?= 6
TEST_TIMEOUT ?= 1800
FULL_TEST ?= 0
TEST_SCOPE := $(if $(filter 1,$(FULL_TEST)),--full,)
TEST_AUDIT_SCOPE := $(if $(filter 1,$(FULL_TEST)),,--allow-skips)

PROVIDER_SOURCES := src/ngcc_prov.c src/ngcc_keymgmt.c src/ngcc_capabilities.c \
                    src/ngcc_context.c src/ngcc_compat.c
ifneq ($(filter kem-%,$(ENABLED_ALGORITHMS)),)
PROVIDER_SOURCES += src/ngcc_kem.c
endif
ifneq ($(filter sig-%,$(ENABLED_ALGORITHMS)),)
PROVIDER_SOURCES += src/ngcc_sig.c src/ngcc_encoder.c src/ngcc_decoder.c
endif
PROVIDER_OBJECTS := $(patsubst src/%.c,build/%.o,$(PROVIDER_SOURCES))
PROVIDER_HEADERS := $(wildcard src/*.h src/*.inc)

include make/ref.mk
include $(sort $(wildcard make/schemes/*.mk))
INTEGRATED_OBJECTS := $(REF_OBJECTS)
ifneq ($(CANDIDATE),)
include make/excluded.mk
endif
OBJECTS := $(PROVIDER_OBJECTS) $(INTEGRATED_OBJECTS)
include make/gmp.mk

.PHONY: all verify-sources clean test check-policy candidate \
        print-provider-sources print-instances print-ref-sources distclean FORCE
all: ngcc.so

# Verify Implementation author bytes in the NGCC-candidates submodule.
# sources.sha256 lists Implementation paths only; extra Specs/ files in the
# submodule are not attested and are ignored by this check.
# Do not fail at Makefile parse time: configure tests copy this file without
# the submodule present. Check here instead, where ngcc.so already depends.
verify-sources:
	@test -d ngcc/candidates/kem-01 || { \
	    printf '%s\n' 'NGCC-candidates submodule is missing. Run: git submodule update --init'; \
	    exit 1; }
	@mkdir -p build
	@cd ngcc/candidates && $(SHA256) -c ../metadata/sources.sha256 \
	    > ../../build/source-check.log 2>&1 || { \
	    cat ../../build/source-check.log; exit 1; }
	@printf '%s\n' 'Author source checksums: OK'

# Detect command-line toolchain/flag changes without rebuilding on every make.
build/config: FORCE
	@mkdir -p build
	@printf '%s\n' $(foreach v,CC LD NM NMEDIT OBJCOPY CFLAGS CPPFLAGS LDFLAGS \
    PLATFORM ARCH TARGET_FLAGS OPENSSL_PREFIX OPENSSL_LIBDIR GMP_LIBRARY,'$(subst ','"'"',$($(v)))') > $@.tmp
	@cmp -s $@.tmp $@ && rm -f $@.tmp || mv -f $@.tmp $@

$(PROVIDER_OBJECTS): build/%.o: src/%.c $(PROVIDER_HEADERS) Makefile build/config
	$(CC) $(CPPFLAGS) $(CFLAGS) $(TARGET_FLAGS) -fPIC -fvisibility=hidden -Wall -Wextra \
	    -MMD -MP -c $< -o $@

ifeq ($(PLATFORM),Darwin)
all: ngcc.dylib

# macOS hosts resolve a provider name to .dylib; keep one actual module file.
ngcc.dylib: ngcc.so
	ln -sf ngcc.so $@

OPENSSL_CRYPTO := $(OPENSSL_LIBDIR)/libcrypto.3.dylib

# Only symbols exported by the selected libcrypto may bind at module load time.
# Other unresolved symbols remain link errors; no C++ runtime is required.
build/crypto-symbols.rsp: $(OBJECTS) $(OPENSSL_CRYPTO) Makefile
	@$(NM) -gU '$(OPENSSL_CRYPTO)' | awk 'NF { print $$NF }' | LC_ALL=C sort -u > build/crypto.exports
	@$(NM) -u $(OBJECTS) | awk 'NF == 1 && /^_/ { print $$1 }' | LC_ALL=C sort -u > build/undefined.symbols
	@LC_ALL=C comm -12 build/crypto.exports build/undefined.symbols | sed 's/^/-Wl,-U,/' > $@

MODULE_FLAGS := -bundle -Wl,-exported_symbol,_OSSL_provider_init @build/crypto-symbols.rsp
MODULE_LIBS := $(GMP_LIBRARY)
MODULE_INPUTS := build/crypto-symbols.rsp
else
build/ngcc.exports: Makefile
	@mkdir -p build
	@printf '%s\n' '{ global: OSSL_provider_init; local: *; };' > $@

MODULE_FLAGS := -shared -Wl,--no-undefined -Wl,--version-script=build/ngcc.exports
MODULE_LIBS := -L$(OPENSSL_LIBDIR) -lcrypto $(GMP_LIBRARY) -lm -lpthread
MODULE_INPUTS := build/ngcc.exports
endif

ngcc.so: $(OBJECTS) $(MODULE_INPUTS) $(GMP_LIBRARY) Makefile | verify-sources
	$(CC) $(LDFLAGS) $(TARGET_FLAGS) -o build/ngcc.pending.so $(OBJECTS) $(MODULE_FLAGS) $(MODULE_LIBS)
	mv -f build/ngcc.pending.so $@
	@$(SHA256) $@ > build/module.sha256

candidate:
	@test -n '$(CANDIDATE)' || { echo 'Use make candidate CANDIDATE=sign-18/Origami-128'; exit 1; }
ifneq ($(CANDIDATE),)
candidate: build/ngcc/$(CANDIDATE)/instance.o
endif

# Python is used only by optional test/report tooling, never by all/clean.
test: all
	$(PYTHON) cc_test/ngcc_test.py --jobs $(JOBS) --timeout $(TEST_TIMEOUT) $(TEST_SCOPE)
	$(PYTHON) cc_test/ngcc_tls.py --jobs $(JOBS) --timeout $(TEST_TIMEOUT) $(TEST_SCOPE)
	$(PYTHON) cc_test/ngcc_threads.py $(TEST_SCOPE)
	$(PYTHON) cc_test/ngcc_cli.py $(TEST_SCOPE)
	$(PYTHON) cc_test/ngcc_audit.py --require-tests $(TEST_AUDIT_SCOPE)

check-policy: all
	$(PYTHON) cc_test/ngcc_audit.py

print-provider-sources:
	@printf '%s\n' $(notdir $(PROVIDER_SOURCES))

print-instances:
	@printf '%s\n' $(REF_INSTANCES)

print-ref-sources:
	@printf '%s\n' $(REF_AUTHOR_SOURCES)

clean:
	rm -rf build/ngcc build/*.o build/*.d build/config build/*.rsp \
	    build/*.exports build/undefined.symbols build/module.sha256 \
	    build/ngcc.pending.so build/gmp build/gmp-config ngcc.so ngcc.dylib

distclean: clean
	rm -f Makefile configdata.json src/ngcc_config.h

-include $(PROVIDER_OBJECTS:.o=.d) $(REF_DEPFILES)
