{"replies_html": "\n\n\n  <div class=\"odd \">\n    <!-- Start email -->\n    \n\n\n\n\n\n\n\n<div class=\"email\">\n\n    <div id=\"GGSOU5DK46JKEP27W2B3KRRAJWCW7CLZ\" class=\"email-header\">\n        <div class=\"gravatar-wrapper d-flex\">\n            <div class=\"gravatar circle\">\n                \n            </div>\n            <div class=\"email-author d-flex\">\n                <h2 class=\"name\">\n                    \n                    <a class=\"aaa\" href=\"/archives/users/45b8e64d36354fb5b1e821ab1b997de3/\"\n                       title=\"See the profile for RunqingXu\"\n                       >RunqingXu</a>\n                    \n                </h2>\n            </div>\n        </div>\n        <div class=\"email-date right\">\n            \n            \n            <span class=\"date d-none d-sm-inline\">\n                22 Sep\n                \n            </span>\n            <span class=\"date d-sm-none\">\n                22 Sep\n                \n            </span>\n            \n            <div class=\"time\">\n                <span title=\"Sender's time: Sept. 22, 2026, 10:43 a.m.\">10:43 a.m.</span>\n            </div>\n\n        </div>\n        \n        <div class=\"subject\">\n          <!--New subject: Round1:%20Public%20Comment:%20Aigis-Enc$^%2B$-->\n        </div>\n        \n    </div> <!-- /email-header: gravatar, author-info, date, peramlink, changed_subject -->\n\n    <div class=\"email-body \">\n      \n<style>\n.email-body .html-content,\n.email-body .html-content table,\n.email-body .html-content td,\n.email-body .html-content th,\n.email-body .html-content div,\n.email-body .html-content p,\n.email-body .html-content span {\n    white-space: normal;\n}\n.email-body .html-content table {\n    border-collapse: collapse;\n    margin: 0.5em 0;\n    max-width: 100%;\n}\n.email-body .html-content td,\n.email-body .html-content th {\n    border: 1px solid #ccc;\n    padding: 4px 8px;\n    vertical-align: top;\n}\n.email-body .html-content img {\n    max-width: 100%;\n    height: auto;\n}\n</style>\n<div class=\"html-content\"><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\">Dear all,</div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\"><br></div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\">We have fixed the two implementation errors in the decryption implementation reported by Markku-Juhani O. Saarinen in https://ngcc.dev/reports/kem-01.html.</div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\">We sincerely thank Markku-Juhani O. Saarinen for his prompt feedback and thorough analysis.</div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\"><br></div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\">We welcome further analysis and comments from the community.</div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\"><br></div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\">Best regards,</div><div style=\"font-family: -apple-system, system-ui; font-size: 14px; color: rgb(0, 0, 0)\">The Aigis-Enc+ Team</div></div>\n    </div>\n\n    \n\n    <div class=\"email-info\">\n      <div class=\"likeform-wrapper right\">\n        <div class=\"messagelink pull-right\">\n          <button class=\"toggle-font btn btn-sm\"\n                title=\"Display in fixed font\"\n                data-bs-toggle=\"tooltip\" data-placement=\"bottom\">\n                <i class=\"fa fa-font\"></i>\n          </button>\n          <a href=\"/archives/list/pkcforum@list.niccs.org.cn/message/GGSOU5DK46JKEP27W2B3KRRAJWCW7CLZ/\"\n             title=\"Permalink for this message\"\n             data-bs-toggle=\"tooltip\" data-placement=\"bottom\"><i class=\"fa fa-link\"></i></a>\n        </div>\